{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$roomCode": {
        ".read": true,
        ".write": "!data.exists() || data.exists()",
        ".validate": "newData.hasChildren(['host', 'players', 'gameState'])",

        "host": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
        },

        "mode": {
          ".validate": "newData.isString() && (newData.val() == 'normal' || newData.val() == 'premium')"
        },

        "gameState": {
          ".validate": "newData.isString() && ['waiting', 'playing', 'roundEnd', 'gameEnd'].contains(newData.val())"
        },

        "players": {
          "$playerName": {
            ".validate": "newData.hasChildren(['name'])",

            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
            },

            "realName": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },

            "hand": {
              ".validate": "newData.isString() || (!newData.exists())"
            },

            "discard": {
              "$cardIndex": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 16"
              }
            },

            "isOut": {
              ".validate": "newData.isBoolean()"
            },

            "isProtected": {
              ".validate": "newData.isBoolean()"
            },

            "tokens": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },

            "chamberlainActive": {
              ".validate": "newData.isBoolean()"
            },

            "hasJesterToken": {
              ".validate": "newData.isBoolean()"
            },

            "dukeActive": {
              ".validate": "newData.isBoolean()"
            }
          }
        },

        "round": {
          "deck": {
            "$cardIndex": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 16"
            }
          },

          "currentPlayer": {
            ".validate": "newData.isString()"
          },

          "roundNumber": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },

          "winner": {
            ".validate": "newData.isString()"
          },

          "winType": {
            ".validate": "newData.isString() && ['lastStanding', 'deckEmpty', 'tiebreaker'].contains(newData.val())"
          },

          "roundEndInProgress": {
            ".validate": "newData.isBoolean()"
          },

          "courtWhispererTarget": {
            ".validate": "newData.isString() || newData.val() === null"
          },

          "courtWhispererExpiresAfter": {
            ".validate": "newData.isString() || newData.val() === null"
          }
        },

        "notifications": {
          "$notificationId": {
            ".validate": "newData.hasChildren(['message', 'timestamp'])",

            "message": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },

            "timestamp": {
              ".validate": "newData.isNumber()"
            }
          }
        },

        "actionResult": {
          "type": {
            ".validate": "newData.isString()"
          },

          "message": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          }
        }
      }
    }
  }
}
